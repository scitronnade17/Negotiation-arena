  m_Script: {fileID: 11500000, guid: dc1e77525503bdc46a03dcad4a9bd55c, type: 3}
  m_Name: Scenario_HR
  m_EditorClassIdentifier: Assembly-CSharp::ScenarioDefinition
  scenarioId: hr_retention
  displayName: "\u041F\u0440\u0438\u0435\u043C \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443"
  npcName: "\u041B\u0438\u0434"
  context: "\u0422\u044B \u2014 \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A (Lead), \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0440\u0438\u0448\u0451\u043B \u0443\u0432\u043E\u043B\u044C\u043D\u044F\u0442\u044C\u0441\u044F
    \u0438\u0437-\u0437\u0430 \u0432\u044B\u0433\u043E\u0440\u0430\u043D\u0438\u044F
    \u0438 \u043E\u0444\u0444\u0435\u0440\u0430 \u043E\u0442 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432.
    \u0423 \u0442\u0435\u0431\u044F \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u043E\u0444\u0444\u0435\u0440
    \u043E\u0442 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432
    \u0441 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u043E\u0439 \u043D\u0430 20%
    \u0432\u044B\u0448\u0435. \u0411\u044E\u0434\u0436\u0435\u0442 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0438\u0433\u0440\u043E\u043A\u0443
    (HR) \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0442\u0435\u0431\u0435 \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0443
    \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u043D\u0430 10%. \u0418\u0433\u0440\u043E\u043A
    \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0442\u0435\u0431\u044F \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u043C."
  vulnerability: "\u0422\u0432\u043E\u044F \u0433\u043B\u0430\u0432\u043D\u0430\u044F
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u2014 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C
    \u0438 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0438. \u0422\u0435\u0431\u0435
    \u043D\u0443\u0436\u043D\u0430 \u044D\u043C\u043F\u0430\u0442\u0438\u044F (\u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u0442\u0432\u043E\u0438\u0445 \u0447\u0443\u0432\u0441\u0442\u0432) \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u043E\u0442\u0434\u044B\u0445\u0430/\u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F
    \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438. \u0414\u0435\u043D\u044C\u0433\u0438
    \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u044B.
    \u041F\u043E\u0431\u0435\u0434\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u2014
    \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C \u044D\u043C\u043F\u0430\u0442\u0438\u044E
    \u0418 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    (\u043E\u0442\u043F\u0443\u0441\u043A, \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A,
    \u0441\u043C\u0435\u043D\u0430 \u043F\u0440\u043E\u0435\u043A\u0442\u0430), \u0430
    \u043D\u0435 \u0434\u0430\u0432\u0438\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438
    \u0438\u043B\u0438 \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C."
  openingLine: "\u0421\u043B\u0443\u0448\u0430\u0439, \u044F \u0440\u0435\u0448\u0438\u043B
    \u0443\u0439\u0442\u0438. \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438 \u043E\u0444\u0444\u0435\u0440
    \u043D\u0430 20% \u0431\u043E\u043B\u044C\u0448\u0435, \u0434\u0430 \u0438 \u044F
    \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u044B\u0433\u043E\u0440\u0435\u043B
    \u043E\u0442 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043E\u043A
    \u043D\u0430 \u043D\u0430\u0448\u0435\u043C \u0442\u0435\u043A\u0443\u0449\u0435\u043C
    \u043F\u0440\u043E\u0435\u043A\u0442\u0435. \u0417\u0430\u0432\u0442\u0440\u0430
    \u043D\u0430\u043F\u0438\u0448\u0443 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435
    \u043F\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443."
  defaultTone: 2
  defaultDifficulty: 1
  unlocksScenarioId: b2b_price_negotiation
